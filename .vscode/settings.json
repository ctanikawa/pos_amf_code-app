{
  "git.mergeEditor": true,
  "editor.hover.enabled": "on",
  "editor.renderWhitespace": "all",
  "editor.rulers": [7, 11, 71, 79],
  "files.associations": {
    "*.COB": "cobol",
    "*.cob": "cobol",
    "*.CBL": "cobol",
    "*.cbl": "cobol",
    "*.COPY": "cobol",
    "*.cpy": "cobol",
    "*.BMS": "cobol",
    "*.bms": "cobol"
  },
  "[cobol]": {
    "editor.rulers": [7, 11, 71, 79],
    "coboleditor.margin": false
  }
}
